{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "scripts/quotes/**/*.ts",
    "tests/quotes/**/*.ts",
    "scripts/risk/**/*.ts",
    "tests/risk/**/*.ts",
    "tests/demo/**/*.ts"
  ]
}
